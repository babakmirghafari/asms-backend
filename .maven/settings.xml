<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!--
    Credentials for GitHub Packages.

    Two separate tokens are used:
    - GITHUB_TOKEN:         used for publishing to asms-backend's own GitHub Packages registry (write)
    - PACKAGES_READ_TOKEN:  used for reading asms-api-contract from its GitHub Packages registry (read)
                            Must be a PAT with read:packages scope stored as a repo secret.
                            Locally: set PACKAGES_READ_TOKEN (export or .env.local).

    If PACKAGES_READ_TOKEN is not set, falls back to GITHUB_TOKEN for local development
    where the developer's own token has access to both repos.
  -->
  <servers>
    <server>
      <id>github</id>
      <username>babakmirghafari</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
    <server>
      <id>github-asms-contract</id>
      <username>babakmirghafari</username>
      <password>${env.PACKAGES_READ_TOKEN}</password>
    </server>
  </servers>

  <!-- Block the gitlab-maven repository that is configured globally but unauthorized -->
  <mirrors>
    <mirror>
      <id>block-gitlab</id>
      <mirrorOf>gitlab-maven</mirrorOf>
      <name>Block unauthorized gitlab repo</name>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>

  <activeProfiles/>

</settings>
