# Copy this file to .env.local and fill in the values.
# .env.local is in .gitignore — never commit secrets.

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/asms
SPRING_DATASOURCE_USERNAME=asms
SPRING_DATASOURCE_PASSWORD=asms

# GitHub Packages authentication
# GITHUB_TOKEN: used for publishing to asms-backend GitHub Packages (write access)
GITHUB_ACTOR=your-github-username
GITHUB_TOKEN=ghp_your_pat_here

# PACKAGES_READ_TOKEN: PAT with read:packages scope — required to download asms-api-contract
# from GitHub Packages. The package is private; GITHUB_TOKEN alone is insufficient in CI
# (cross-repo package reads require a dedicated token). In CI, stored as a repo secret.
PACKAGES_READ_TOKEN=ghp_your_pat_with_read_packages_here

# JWT configuration
JWT_JWKS_URI=http://localhost:8080/asms/v1/.well-known/jwks.json

# ASMS application settings
ASMS_AUTH_MAX_FAILED_ATTEMPTS=5
ASMS_AUTH_LOCKOUT_DURATION=15
ASMS_AUTH_TOKEN_EXPIRY=60
ASMS_PERMISSION_CACHE_TTL=300
